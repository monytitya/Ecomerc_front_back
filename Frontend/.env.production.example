# Set these Vite variables in the frontend hosting provider before building.
# They are embedded in the public frontend bundle; never put secrets here.
VITE_API_URL=https://your-backend-domain.example/api
VITE_GOOGLE_CLIENT_ID=replace-with-google-client-id
VITE_GOOGLE_REDIRECT_URI=https://your-frontend-domain.example/oauth2/callback
